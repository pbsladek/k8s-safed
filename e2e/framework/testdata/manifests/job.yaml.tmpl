apiVersion: batch/v1
kind: Job
metadata:
  name: {{ .Name }}
  namespace: {{ .Namespace }}
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        app: {{ .App }}
    spec:
      restartPolicy: Never
      terminationGracePeriodSeconds: 2
      containers:
      - name: app
        image: {{ .Image }}
        command: ["/bin/sh", "-c", {{ printf "%q" .Command }}]
        resources:
          requests:
            cpu: 10m
            memory: 8Mi
